# Public URL of the site (used in emails, share links and OG images).
# Netlify is configured for the planned custom domain; use the Netlify URL until DNS is connected.
NEXT_PUBLIC_SITE_URL=https://csweek26.ruut.chat

# Convert by Ruut. Without a key, emails go to the dev outbox (/dev/outbox/<id>).
# A recipient is added to contact list 21 when a card is submitted with email sending enabled.
CONVERT_API_KEY=YOUR_CONVERT_API_KEY
CONVERT_API_BASE=https://convert.ruut.chat/api/v1
CONVERT_CONTACT_LIST_ID=21
# Card storage. Without these, cards are stored in ./.data (fine locally, not on serverless hosts).
UPSTASH_REDIS_REST_URL=https://better-lemming-196111.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Optional variables, not currently configured on Netlify:
# CONVERT_SENDER=
# CONVERT_TEST_MODE=false
# ADMIN_TOKEN=
