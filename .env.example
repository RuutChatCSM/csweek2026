# Public URL of the site (used in emails, share links and OG images)
NEXT_PUBLIC_SITE_URL=https://csweek.ruut.chat

# Convert by Ruut — email delivery. Without these, emails go to the dev outbox (/dev/outbox/<id>).
CONVERT_API_URL=
CONVERT_API_KEY=
CONVERT_FROM_EMAIL=celebrate@ruut.chat
CONVERT_FROM_NAME=CS Week by Ruut

# Card storage. Without these, cards are stored in ./.data (fine locally, not on serverless hosts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Moderation: DELETE /api/cards/<id> with header x-admin-token hides a card from the wall
ADMIN_TOKEN=
